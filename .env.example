APP_NAME="API Wilayah Indonesia 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration
# ==============================================================================
# Pilihan 1: SQLite (Direkomendasikan untuk testing & dev tanpa setup server DB)
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# Pilihan 2: MySQL / MariaDB (Default)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apiwilayah2026
DB_USERNAME=root
DB_PASSWORD=

# Pilihan 3: PostgreSQL (Supabase / Neon.tech untuk Vercel)
# DB_CONNECTION=pgsql
# DB_HOST=ep-example.ap-southeast-1.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=user
# DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Vercel Serverless Configuration (Hanya diperlukan saat deploy di Vercel)
# ==============================================================================
# LARAVEL_STORAGE_PATH=/tmp/storage
# VIEW_COMPILED_PATH=/tmp/storage/framework/views
